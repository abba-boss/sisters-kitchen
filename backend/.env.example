PORT=5000
NODE_ENV=development
# Set to "true" only for local development. Never enable against production.
DB_SYNC=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=sisters_kitchen

# JWT — replace with long random values
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=sisters_kitchen

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# App
# Comma-separated list of allowed origins, e.g. https://app.example.com,https://www.example.com
FRONTEND_URL=http://localhost:5173
DEBUG_OTP=false

# Password-reset email (optional in development, required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sisters Kitchen <no-reply@example.com>"
