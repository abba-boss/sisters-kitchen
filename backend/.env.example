# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# DB_TYPE=sqlite (default, development) | mysql (production)
DB_TYPE=sqlite

# SQLite only
DB_DATABASE=./data/sisters_kitchen.sqlite

# MySQL only (used when DB_TYPE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here
DB_NAME=sisters_kitchen
# Managed MySQL providers usually require TLS:
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Schema is managed by migrations only. Leave DB_MIGRATIONS_RUN=false and run
# `npm run migration:run` as a deploy step (set it true only for single-node
# deployments that should migrate on boot).
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# JWT Configuration (Generate strong random strings for production)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_64_chars_use_crypto_random_bytes
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars_use_crypto_random_bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=sisters_kitchen

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_your_test_key_or_sk_live_for_production
PAYSTACK_PUBLIC_KEY=pk_test_your_test_key_or_pk_live_for_production

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Sentry Error Monitoring (Optional but recommended for production)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Email Configuration (SMTP)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use App Password
# For SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587
# For development: Leave empty to use Ethereal test email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Sisters Kitchen" <noreply@sisterskitchen.ng>

# Ethereal Test Email (Development only - get from https://ethereal.email)
ETHEREAL_USER=
ETHEREAL_PASS=

# Public URL of this API (used for local /uploads image URLs)
API_URL=http://localhost:5000
API_PUBLIC_URL=http://localhost:5000
